# =============================================================================
# WebStock UMBRELLA — environment template for docker-compose.all.yml
#
#   cp .env.all.example .env   &&   edit values below
#
# Brings up FOUR stacks: WebStock + StockPulse + AlphaForge + NewsForge.
# Every var is namespaced per stack to avoid collisions:
#   WS_ = WebStock   SP_ = StockPulse   AF_ = AlphaForge   NF_ = NewsForge
# A handful of unprefixed vars (FINNHUB_API_KEY, SMTP_*, VAPID_*, and the
# three CROSS-STOCK CONSUMER KEYS) belong to WebStock and keep their original
# names because that is what the WebStock image reads.
#
# NEVER commit your filled-in .env.
# =============================================================================


# =============================================================================
# Host-published ports (host:container). Change if these collide on your host.
# =============================================================================
APP_PORT=80          # WebStock   -> http://localhost:${APP_PORT}
SP_APP_PORT=8010     # StockPulse -> http://localhost:8010
AF_APP_PORT=8015     # AlphaForge -> http://localhost:8015
NF_APP_PORT=8080     # NewsForge  -> http://localhost:8080


# =============================================================================
# Per-stack PostgreSQL passwords  (REQUIRED — set distinct strong values)
# -----------------------------------------------------------------------------
# StockPulse HARD-FAILS to start if SP_POSTGRES_PASSWORD is unset.
# (NOTE: changing a password after the pg volume is initialized has NO effect —
#  the password is baked into the data dir on first init. Set these BEFORE the
#  very first `up`.)
# =============================================================================
WS_POSTGRES_PASSWORD=change-this-webstock-db-password
SP_POSTGRES_PASSWORD=change-this-stockpulse-db-password
AF_POSTGRES_PASSWORD=change-this-alphaforge-db-password
NF_POSTGRES_PASSWORD=change-this-newsforge-db-password

# NewsForge pg user/db (defaults are fine; must match across pg + app — they do)
NF_POSTGRES_USER=newsforge
NF_POSTGRES_DB=newsforge


# =============================================================================
# StockPulse Redis password (preserve a value; default 'stockpulse')
# Used by both the redis `--requirepass` and the app's REDIS_URL — keep in sync.
# =============================================================================
SP_REDIS_PASSWORD=stockpulse
# (AlphaForge / NewsForge / WebStock redis have NO password — matches sources.)


# =============================================================================
# Per-stack JWT secret keys
# -----------------------------------------------------------------------------
# SP / AF / NF: each app auto-generates and persists its OWN secret in its DB
# when left EMPTY (and even ignores a leftover example placeholder), so blank is
# a fine quick start for those three.
#
# WS_JWT_SECRET_KEY is DIFFERENT  ***  SECURITY-CRITICAL  ***
#   WebStock does NOT auto-generate it (no DB fallback). The compose HARD-FAILS
#   the deploy if this is left empty (`${WS_JWT_SECRET_KEY:?...}`), so you cannot
#   accidentally ship a blank/weak signing key. Generate one before first `up`:
#       openssl rand -hex 32
# =============================================================================
WS_JWT_SECRET_KEY=
WS_JWT_SECRET_KEY_PREVIOUS=
SP_JWT_SECRET_KEY=
AF_JWT_SECRET_KEY=
NF_JWT_SECRET_KEY=


# =============================================================================
# First-admin emails
# -----------------------------------------------------------------------------
# StockPulse & AlphaForge AUTO-SEED an admin on first boot regardless of this:
#     StockPulse: admin@stockpulse.dev / Admin123
#     AlphaForge: admin@alphaforge.dev / Admin123
#   (Their FIRST_ADMIN_EMAIL just whitelists who else may claim admin via
#    /register; leave blank to keep the auto-seeded admin only.)
# NewsForge has NO auto-seed: the FIRST /register call becomes admin, and if
#   NF_FIRST_ADMIN_EMAIL is set it acts as a whitelist — only that email may
#   claim the bootstrap admin slot.
# WebStock promotes WS_FIRST_ADMIN_EMAIL to admin on startup if it has already
#   registered and no admin exists yet.
# CHANGE the Admin123 defaults ASAP after first login (see DEPLOY-umbrella.md).
# =============================================================================
WS_FIRST_ADMIN_EMAIL=admin@example.com
SP_FIRST_ADMIN_EMAIL=
AF_FIRST_ADMIN_EMAIL=
NF_FIRST_ADMIN_EMAIL=admin@newsforge.local


# =============================================================================
# CROSS-STACK API KEYS  ***START EMPTY — MINTED MANUALLY AFTER FIRST BOOT***
# -----------------------------------------------------------------------------
# Each raw key is shown ONLY ONCE at creation. Follow DEPLOY-umbrella.md §4 to
# mint them, then paste the values here and re-create the consuming apps:
#   docker compose -f docker-compose.all.yml up -d --force-recreate \
#       alphaforge-app webstock-app
#
# WHO CONSUMES WHOM:
#   - AlphaForge   -> StockPulse   (AF_STOCKPULSE_API_KEY)   minted IN StockPulse
#   - WebStock     -> StockPulse   (STOCKPULSE_API_KEY)      minted IN StockPulse
#   - WebStock     -> AlphaForge   (ALPHAFORGE_API_KEY)      minted IN AlphaForge
#   - WebStock     -> NewsForge    (NEWSFORGE_API_KEY)       minted IN NewsForge
# These are FOUR DISTINCT keys. Do not reuse one for another.
# =============================================================================

# --- AlphaForge's key for calling StockPulse (consumer name: "alphaforge") ---
AF_STOCKPULSE_API_KEY=

# --- WebStock's keys (WebStock image reads these EXACT names) ----------------
STOCKPULSE_API_KEY=        # WebStock -> StockPulse (consumer name: "webstock")
ALPHAFORGE_API_KEY=        # WebStock -> AlphaForge (consumer name: "webstock")
NEWSFORGE_API_KEY=         # WebStock -> NewsForge  (consumer name: "webstock")

# --- (Optional) AlphaForge's key for calling NewsForge sentiment -------------
# Only needed if you wire AlphaForge -> NewsForge sentiment. Mint a NewsForge
# consumer named "alphaforge" the same way as the webstock one.
AF_NEWSFORGE_API_KEY=

# --- (Optional) NewsForge's key for pulling per-symbol news from StockPulse ---
# Only needed if you uncomment the NewsForge->StockPulse block in
# docker-compose.all.yml. Mint a StockPulse consumer named "newsforge".
# NF_STOCKPULSE_API_KEY=

# --- DEAD / DISABLED webhook secret ------------------------------------------
# WebStock has a VESTIGIAL NEWSFORGE_WEBHOOK_SECRET config field, but NO inbound
# webhook receiver route consumes/verifies it (the receiver was dropped). The
# NewsForge -> WebStock push webhook is therefore disabled; NewsForge mints its
# own per-webhook secrets anyway. Sentiment is PULLED on-demand by WebStock
# instead, so NEWSFORGE_WEBHOOK_SECRET is intentionally absent here. Leave unset.


# =============================================================================
# WebStock cross-stack URLs (defaults already point at in-network service DNS
# on the nginx port :80 — override only if you really know why).
# =============================================================================
WS_STOCKPULSE_URL=http://stockpulse-app
WS_ALPHAFORGE_URL=http://alphaforge-app
WS_NEWSFORGE_URL=http://newsforge-app


# =============================================================================
# WebStock — other settings
# -----------------------------------------------------------------------------
# LLM PROVIDERS ARE NOT CONFIGURED HERE. WebStock reads NO OPENAI_API_KEY from
# env — add at least one provider in Admin -> Settings -> LLM Providers after
# boot, or all LLM features stay disabled. (NewsForge DOES use NF_OPENAI_API_KEY
# below for its own pipeline.)
# =============================================================================
# WebStock CORS_ORIGINS MUST be a JSON ARRAY (pydantic list[str], json.loads) —
# NOT a comma-separated string (that, and an empty value, crash config load).
# ["*"] allows all origins (fine behind your own ingress); for public exposure
# restrict it, e.g. WS_CORS_ORIGINS=["https://stocks.example.com"].
# (Note: SP_/AF_/NF_CORS_ORIGINS above ARE plain comma-separated strings —
#  different format per project; do not mix them up.)
WS_CORS_ORIGINS=["*"]
INTERNAL_API_TOKEN=        # enables /api/v1/internal + embedded AI Gateway auth (openssl rand -hex 32)
USE_AI_GATEWAY=false
WS_RSSHUB_URL=http://webstock-rsshub:1200
WS_RSSHUB_ACCESS_KEY=

# WebStock upstream market-data keys (WebStock-side; StockPulse has its own SP_*)
FINNHUB_API_KEY=
TUSHARE_TOKEN=
TAVILY_API_KEY=
PLAYWRIGHT_SERVICE_URL=

# Email (SMTP) — leave blank to disable
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Web Push (VAPID) — npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@webstock.local


# =============================================================================
# StockPulse — upstream provider keys (optional; also settable in SP admin UI)
# =============================================================================
SP_CORS_ORIGINS=*
SP_LOG_LEVEL=info
# First-boot data seed: empty = StockPulse downloads a market-data snapshot
# (symbols+profiles+daily bars) from a GitHub release on first start — several
# minutes + GBs of disk, and /health stays down until it finishes. Set to
# `skip` to boot with an empty DB and collect data live instead.
SP_SEED_RELEASE=
SP_FINNHUB_API_KEY=
SP_TUSHARE_TOKEN=
SP_TIINGO_API_KEY=
SP_TAVILY_API_KEY=
SP_POLYGON_API_KEY=


# =============================================================================
# AlphaForge — settings
# -----------------------------------------------------------------------------
# AI_GATEWAY_URL (RD-Agent LLM) is intentionally NOT set in the compose:
# WebStock's AI Gateway binds 127.0.0.1:8004 inside its own container and is
# unreachable cross-container, so RD-Agent LLM features are un-wired. To enable,
# provide a cross-container-reachable LLM endpoint and uncomment AI_GATEWAY_URL
# in docker-compose.all.yml.
# =============================================================================
AF_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8015
AF_LOG_LEVEL=info


# =============================================================================
# NewsForge — LLM pipeline (does NOT block boot if empty)
# =============================================================================
NF_OPENAI_API_KEY=
NF_OPENAI_API_BASE=https://api.openai.com/v1
NF_OPENAI_MODEL=gpt-4o-mini
NF_CORS_ORIGINS=*
NF_LOG_LEVEL=INFO
# NewsForge reuses WebStock's rsshub by default (its own rsshub is omitted):
NF_RSSHUB_URL=http://webstock-rsshub:1200
