# =============================================================================
# WebStock Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment
# IMPORTANT: Never commit .env to version control!
# =============================================================================
#
# Deployment model: docker-compose.prod.yml runs the WebStock CORE only —
# PostgreSQL, Redis, RSSHub and the app container. The data (StockPulse), ML
# (AlphaForge) and news (NewsForge) sub-projects are deployed SEPARATELY and
# wired in via the integration vars below (see "External Sub-Project
# Integrations"). LLM providers are configured in the Admin UI, not here.
# =============================================================================

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=WebStock
APP_VERSION=1.0.0
# Set to true for development, false for production
DEBUG=false
# Environment: development, staging, production
ENVIRONMENT=production

# =============================================================================
# Server Settings
# =============================================================================
HOST=0.0.0.0
PORT=8000

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
# PostgreSQL connection string (asyncpg driver for async support)
DATABASE_URL=postgresql+asyncpg://webstock:webstock@postgres:5432/webstock
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=webstock
POSTGRES_PASSWORD=change-this-secure-password
POSTGRES_DB=webstock

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=10

# Celery Redis URLs (separate databases for isolation)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# =============================================================================
# JWT Configuration
# =============================================================================
# CRITICAL: Generate a strong secret key for production!
# Generate with: openssl rand -hex 32
# OR: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-a-secure-random-key-here-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Security Settings
# =============================================================================
# bcrypt hash rounds (12 is recommended, higher = slower but more secure)
BCRYPT_ROUNDS=12

# Account lockout settings
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# AI Analysis Rate Limiting (per user)
AI_ANALYSIS_RATE_LIMIT=10
OPENAI_RATE_LIMIT=50

# =============================================================================
# CORS Settings
# =============================================================================
# JSON ARRAY of allowed origins — config.py parses this as list[str] via
# json.loads, so it must be valid JSON. A comma-separated string OR an empty
# value will CRASH startup (config load fails → migrations + Celery die).
# Use ["*"] to allow all; restrict for production, e.g. ["https://yourdomain.com"].
CORS_ORIGINS=["*"]

# =============================================================================
# LLM / AI Models — configured in the Admin UI, NOT via env
# =============================================================================
# IMPORTANT: The backend no longer reads OPENAI_API_KEY / OPENAI_MODEL /
# OPENAI_API_BASE / OPENAI_MAX_TOKENS from the environment (these vars are
# silently ignored — config.py uses extra="ignore"). LLM credentials and the
# purpose mappings (chat / analysis / synthesis / embedding / discussion /
# prediction + the L3 news agents) live in the database and are managed at:
#     Admin → Settings → LLM Providers
# On a fresh deploy, ALL LLM-dependent features stay disabled until an admin
# adds at least one provider and maps the purposes. There is NO env fallback.
# (The OPENAI_RATE_LIMIT_* throttling knobs ARE still read from env.)

# Optional: route all LLM traffic through the embedded AI Gateway (port 8004,
# auth'd by INTERNAL_API_TOKEN). Default false — leave false unless you
# specifically want gateway routing.
USE_AI_GATEWAY=false

# =============================================================================
# External Market-Data API Keys
# =============================================================================
# Finnhub API key for real-time stock data
# Get your key at: https://finnhub.io/register
FINNHUB_API_KEY=your-finnhub-api-key-here

# Optional: Alpha Vantage API key for additional stock data
ALPHA_VANTAGE_API_KEY=

# Optional: TuShare token for Chinese market data
TUSHARE_TOKEN=

# Optional: Tiingo API key for US stock data (fallback provider)
# Get your key at: https://www.tiingo.com/
TIINGO_API_KEY=

# Optional: Polygon.io API key for news full content
# Get your key at: https://polygon.io/
POLYGON_API_KEY=

# =============================================================================
# Email Configuration (SMTP)
# =============================================================================
# Leave empty to disable email functionality
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@webstock.local

# =============================================================================
# Web Push Notifications (VAPID)
# =============================================================================
# Generate VAPID keys with: npx web-push generate-vapid-keys
# Or use: https://vapidkeys.com/
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@webstock.local

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# First Admin Configuration
# =============================================================================
# Email address of the first admin user
# This user will be promoted to admin role on first startup (if no admins exist)
# The user must register first, then restart the server to be promoted
# FIRST_ADMIN_EMAIL=admin@example.com

# =============================================================================
# Internal API (Machine-to-Machine)
# =============================================================================
# Shared token used by (1) the /api/v1/internal endpoints and (2) auth between
# the backend and the embedded AI Gateway (port 8004).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty to disable the internal API (returns 503) AND disable AI Gateway
# auth — set a real value for any non-dev deployment.
INTERNAL_API_TOKEN=

# =============================================================================
# External Sub-Project Integrations (StockPulse / AlphaForge / NewsForge)
# =============================================================================
# WebStock's market-data, ML-prediction and news subsystems were extracted into
# three standalone services. They are NOT part of this docker-compose stack —
# deploy each separately, then point WebStock at it here OR via the Admin UI
# (Admin → Settings → Integrations), which stores the same values in the
# integration_settings table and takes effect WITHOUT a restart.
#
# Precedence: integration_settings (DB) overrides these env vars.
# Leave a URL empty to keep that integration disabled (the platform still
# starts; the related features are simply unavailable).
#
# Same-host tip: when a sub-project runs on the same machine in a different
# docker-compose project, reach it via host.docker.internal (the app container
# already maps host.docker.internal → host-gateway).

# --- StockPulse: market data (quotes / history / fundamentals) --------------
# Create a "webstock" consumer in StockPulse's admin UI and paste its API key.
# Without it, all quote/history/info/financials calls return empty.
STOCKPULSE_URL=http://host.docker.internal:8010
STOCKPULSE_API_KEY=

# --- AlphaForge: ML prediction engine (LightGBM + Qlib + RD-Agent) ----------
# Create a "webstock" consumer in AlphaForge's admin UI and paste its API key.
# Without it, ML prediction / Qlib / RD-Agent features are unavailable.
ALPHAFORGE_URL=http://host.docker.internal:8015
ALPHAFORGE_API_KEY=

# --- NewsForge: news ingestion + sentiment ----------------------------------
# NEWSFORGE_WEBHOOK_SECRET authenticates push callbacks from NewsForge.
# Without it, news feed / sentiment features return empty.
NEWSFORGE_URL=
NEWSFORGE_API_KEY=
NEWSFORGE_WEBHOOK_SECRET=

# =============================================================================
# RSSHub Configuration
# =============================================================================
# RSSHub service URL (default uses Docker internal network)
RSSHUB_URL=http://rsshub:1200
# Optional: RSSHub access key for authentication
RSSHUB_ACCESS_KEY=

# =============================================================================
# Content Extraction Fallback Configuration (Optional)
# =============================================================================
# Tavily Extract API key for advanced content extraction fallback
# Get your key at: https://tavily.com/
# Free tier: 1000 extractions/month
TAVILY_API_KEY=

# Playwright extraction service URL (optional, only set when using playwright profile)
# Start with: docker-compose --profile playwright up -d
# Leave empty/unset to disable Playwright fallback
# PLAYWRIGHT_SERVICE_URL=http://playwright-service:8002

# =============================================================================
# Production Checklist
# =============================================================================
# Before deploying to production, ensure:
# [ ] POSTGRES_PASSWORD is changed from default
# [ ] JWT_SECRET_KEY is a cryptographically secure random string
# [ ] DEBUG is set to false
# [ ] ENVIRONMENT is set to production
# [ ] CORS_ORIGINS contains only your actual domains
# [ ] All API keys are valid and not test keys
# [ ] INTERNAL_API_TOKEN is set (enables /api/v1/internal + AI Gateway auth)
# [ ] StockPulse / AlphaForge / NewsForge are deployed and reachable, and their
#       URL + API key are set here (or in Admin -> Settings -> Integrations)
# [ ] At least one LLM provider is configured in Admin -> Settings -> LLM
#       Providers (no env fallback — OPENAI_API_KEY is ignored)
# [ ] FIRST_ADMIN_EMAIL account is registered, then the app restarted to promote
# [ ] SMTP settings are configured for email notifications
# [ ] VAPID keys are generated for push notifications
# [ ] SSL certificates are configured in nginx
# [ ] Database backups are configured
# [ ] Log rotation is configured
# =============================================================================
